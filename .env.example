NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://terrarila:local-dev-only@localhost:5432/terrarila
# For hosted Postgres: set verify-full. Never disable certificate verification.
PG_SSL=disable
DB_POOL_MAX=5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional direct connection, used ONLY by migrations/seed, never request handlers.
# MIGRATION_DATABASE_URL=postgresql://...
# Optional: HTTPS BE/CDN origin serving /assets; empty keeps portable /assets paths.
ASSET_BASE_URL=
SWAGGER_ENABLED=true
# Google Identity Services Web client ID. Never put a client secret in FE.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_TTL_SECONDS=86400
# Persistent filesystem directory for bundled assets and admin uploads.
MEDIA_STORAGE=local
MEDIA_ROOT=storage/assets
# Safe request metadata only; no query strings, bodies, tokens or customer contact.
LOG_REQUESTS=false
# Local backup wrapper creates RSA keys and encrypted bundles here (gitignored).
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
# Generic backup/restore commands accept keys as file paths, not secret values.
# BACKUP_PUBLIC_KEY=/secure/path/backup.public.pem
# BACKUP_PRIVATE_KEY=/offline/path/backup.private.pem
# PG_CONTAINER=terrarila-be-postgres-1
# RESTORE_DATABASE_URL=postgresql://.../terrarila_restore_test
# RESTORE_MEDIA_ROOT=/separate/empty/directory

# Vercel: use MEDIA_STORAGE=vercel-blob and a hosted PostgreSQL database.
# Public store contains only validated images + migrated website assets under assets/.
# BLOB_READ_WRITE_TOKEN=
# Separate PRIVATE store for unvalidated originals; never use a PUBLIC_ prefix.
# BLOB_UPLOAD_READ_WRITE_TOKEN=
# ASSET_BASE_URL=https://<public-store-id>.public.blob.vercel-storage.com
# Required for production cron cleanup. Use a random secret, not an admin token.
# CRON_SECRET=
